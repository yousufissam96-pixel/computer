input:focus, textarea:focus { border-color: var(--cyan); }

button { border: 0px; border-radius: 11px; padding: 11px 13px; cursor: pointer; color: rgb(6, 17, 29); background: linear-gradient(110deg,var(--cyan),#8b9cff); transition: 0.18s; }

button:active { transform: scale(0.98); }

button.secondary { background: rgb(26, 41, 65); color: var(--txt); border: 1px solid var(--line); }

button.danger { background: rgb(81, 35, 51); color: rgb(255, 220, 226); border: 1px solid rgb(142, 64, 83); }

button.green { background: rgb(22, 67, 51); color: rgb(186, 255, 223); border: 1px solid rgb(39, 116, 86); }

button:disabled { opacity: 0.45; cursor: not-allowed; }

.row { display: flex; gap: 8px; align-items: center; }

.row > * { flex: 1 1 0%; min-width: 0px; }

.nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; margin: 15px 0px; }

.nav button { background: rgb(16, 26, 42); color: var(--muted); border: 1px solid var(--line); padding: 10px 4px; font-size: 11px; }

.nav button.active { color: var(--cyan); border-color: rgb(54, 113, 140); background: rgb(16, 37, 56); }

.page { display: none; }

